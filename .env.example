# Xiuxiu configuration.
#
# Copy this file to ".env" and fill in the values. Resolution precedence is:
#   1. real environment variables (highest)
#   2. %APPDATA%\xiuxiu\.env   <- recommended location (user-only readable)
#   3. <directory containing xiuxiu.exe>\.env   <- portable/single-user installs
#
# SECURITY: GROQ_API_KEY is a billable credential. Do NOT place a populated
# .env in a world-readable directory (e.g. a shared drive or Program Files on a
# multi-user machine). Prefer %APPDATA%\xiuxiu\ or a user-profile install.

# Which backend to use on launch: "local" or "groq". Defaults to "groq" if unset.
BACKEND=groq

# Required when BACKEND=groq. Your Groq API key (https://console.groq.com/keys).
GROQ_API_KEY=

# Required when BACKEND=local. Absolute path to a ggml whisper model file,
# e.g. ggml-base.en.bin (see README for Hugging Face download links).
WHISPER_MODEL_PATH=

# Global push-to-talk hotkey. Defaults to "Ctrl+Alt+Space" if unset.
# Syntax: modifiers + a key, joined by "+" (case-insensitive). Modifiers:
# Ctrl/Control, Alt/Option, Shift, Super/Cmd/Command (NOT Win/Meta). Keys are
# names like Space, or letters as A / KeyA. Examples: Ctrl+Alt+Space, Ctrl+Alt+J.
# If the default is already taken by another app, set this to a free combination.
# AltGr caveat: on layouts where Right-Alt is AltGr, AltGr sends Ctrl+Alt — use a
# combo without Alt (e.g. Ctrl+Shift+J) on those keyboards.
# HOTKEY=Ctrl+Alt+Space
